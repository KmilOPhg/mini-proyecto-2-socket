# Puerto del servidor (Render lo pone automáticamente)
PORT=3001

# Clave secreta JWT (debe ser la misma que usa el backend principal)
JWT_SECRET=cambia_este_secreto_en_produccion

# Service account de Firebase Admin (JSON en una línea) o ruta al archivo
FIREBASE_SERVICE_ACCOUNT=

# URL del frontend para CORS de Socket.io
FRONTEND_URL=http://localhost:5173

# Clave interna para comunicación backend → socket server
# Debe ser la misma en el backend principal (INTERNAL_API_KEY)
INTERNAL_API_KEY=

# Dominio(s) institucionales permitidos, separados por coma (vacío = acepta todos)
INSTITUTIONAL_EMAIL_DOMAINS=
